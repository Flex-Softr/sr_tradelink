# ==========================================
# Core Application Settings
# ==========================================
# Database Connection (MongoDB)
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/dbname"

# NextAuth Configuration
# The base URL of your application (e.g., http://localhost:3000 for local dev, or your production domain)
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ==========================================
# Standalone Server Options (Production only)
# ==========================================
# The port the Next.js standalone server will listen on
PORT=3000
# The hostname to bind to (0.0.0.0 allows external access)
HOSTNAME="0.0.0.0"

# ==========================================
# Database Seeding Options
# ==========================================
# These credentials will be used when you run `npm run seed` to create the initial admin user.
SEED_ADMIN_EMAIL="admin@srtradelink.com"
SEED_ADMIN_PASSWORD="Admin@123456"

# ==========================================
# Legacy Data Sync (Migration)
# ==========================================
# Connection string to the legacy MongoDB cluster containing previous data (only needed during initial migration)
LEGACY_MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0"

# ==========================================
# Email / SMTP Settings (For Password Reset)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
