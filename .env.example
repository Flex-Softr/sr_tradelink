DATABASE_URL="mongodb://username:password@cluster.mongodb.net/dbname"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Next.js Standalone Production Port (Optional)
PORT=3000

# Legacy MongoDB Sync Connection String (Only needed for data migration)
LEGACY_MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0"
